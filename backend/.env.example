# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_NEW_PASSWORD@localhost:5432/phoenix

# Razorpay Test Mode (never use live keys in development)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Merchant API authentication (required outside development/test)
MERCHANT_API_KEY=replace_with_a_long_random_secret
